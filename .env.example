PROJECT_NAME=EduCode Enterprise 2.0
ENVIRONMENT=development
DEBUG=true

POSTGRES_DB=educode
POSTGRES_USER=educode
POSTGRES_PASSWORD=educode_dev_password
POSTGRES_EXTERNAL_PORT=5434
BACKEND_EXTERNAL_PORT=8000
FRONTEND_EXTERNAL_PORT=5173
POSTGRES_VOLUME_NAME=educode-postgres-data
FRONTEND_NODE_MODULES_VOLUME_NAME=educode-frontend-node-modules
DOCUMENT_STORAGE_VOLUME_NAME=educode-document-storage
DATABASE_URL=postgresql+asyncpg://educode:educode_dev_password@db:5432/educode
DOCUMENT_STORAGE_PATH=/app/storage/documents
MAX_DOCUMENT_SIZE_MB=25

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:8000/api/v1

JWT_SECRET_KEY=troque-esta-chave-por-uma-chave-longa-e-aleatoria-com-mais-de-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

INITIAL_ADMIN_EMAIL=admin@educode.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Administrador EduCode
INITIAL_ORGANIZATION_NAME=EduCode Enterprise
INITIAL_ORGANIZATION_SLUG=educode-enterprise

# Biblioteca Criativa
CREATIVE_STORAGE_VOLUME_NAME=educode-creative-storage
CREATIVE_STORAGE_PATH=/app/storage/creative
MAX_CREATIVE_ASSET_SIZE_MB=25

# Recuperação e RAG — Sprint 05
RETRIEVAL_CHUNK_TARGET_CHARS=1000
RETRIEVAL_CHUNK_OVERLAP_CHARS=160
RETRIEVAL_CHUNK_MIN_CHARS=200
RETRIEVAL_DEFAULT_TOP_K=8

# Biblioteca Institucional — Sprint 10.1
INSTITUTIONAL_ASSET_STORAGE_VOLUME_NAME=educode-institutional-assets
INSTITUTIONAL_ASSET_STORAGE_PATH=/app/storage/institutional-assets
MAX_INSTITUTIONAL_ASSET_SIZE_MB=50

# EduCode AI Fabric — Sprint 12
# mock: sempre local; hybrid: usa provedor configurado e fallback mock; real: exige provedor real.
AI_EXECUTION_MODE=hybrid
AI_DEFAULT_TIMEOUT_SECONDS=60
# Exemplo de variável referenciada pelo cadastro administrativo do provedor.
# Nunca envie esta chave ao frontend e não a versiona com valor real.
EDUCODE_AI_API_KEY=

# Sprint 12.2 — filas e workers
REDIS_URL=redis://redis:6379/0
REDIS_EXTERNAL_PORT=6380
REDIS_VOLUME_NAME=educode-redis-data
JOB_QUEUE_PREFIX=educode
WORKER_HEARTBEAT_SECONDS=10
WORKER_STEP_DELAY_MS=150
JOB_EVENT_RETENTION_DAYS=30
MAX_CONCURRENT_JOBS_PER_USER=5

# Sprint 13 — homologação, segurança e recuperação
COMMIT_SHA=
MAINTENANCE_MODE=false
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=3
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=300
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_AI_REQUESTS=30
BACKUP_STORAGE_PATH=/app/storage/backups
BACKUP_STORAGE_VOLUME_NAME=educode-backup-storage

# Sprint 13.1 — operação e observabilidade
OBSERVABILITY_METRICS_TOKEN=
METRIC_SNAPSHOT_INTERVAL_SECONDS=60
METRIC_RETENTION_DAYS=30
OTEL_ENABLED=false
OTEL_SERVICE_NAME=educode-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=0.10
PROMETHEUS_EXTERNAL_PORT=9090
PROMETHEUS_VOLUME_NAME=educode-prometheus-data
GRAFANA_EXTERNAL_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_VOLUME_NAME=educode-grafana-data

# Sprint 13.2 — releases, recuperação e continuidade
PUBLIC_BASE_URL=http://localhost:5173
MAINTENANCE_ACCESS_MODE=available
DEPLOYMENT_STRATEGY=rolling
REVERSE_PROXY_ENABLED=false
REQUIRE_RELEASE_BACKUP=true
REQUIRE_RELEASE_APPROVAL=true
RELEASE_MONITORING_MINUTES=30
DEFAULT_RPO_MINUTES=1440
DEFAULT_RTO_MINUTES=240
WORKER_DRAIN_TIMEOUT_SECONDS=300
SECRET_PROVIDER=environment

# Sprint 13.3 — infraestrutura distribuída, object storage e GitOps
APP_VERSION=0.16.11.5
BUILD_IDENTIFIER=sprint-16.11.5-hq-adaptation-interventions
KUBERNETES_ENABLED=false
GITOPS_ENABLED=false
INFRASTRUCTURE_CLUSTER_NAME=educode-local
INFRASTRUCTURE_REGION=local
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_PATH=/app/storage/objects
OBJECT_STORAGE_LOCAL_VOLUME_NAME=educode-object-storage-local
OBJECT_STORAGE_VOLUME_NAME=educode-object-storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=educode
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=educode
S3_SECRET_ACCESS_KEY=educode-minio-change-this-password
S3_PREFIX=educode
S3_USE_SSL=false
MINIO_ROOT_USER=educode
MINIO_ROOT_PASSWORD=educode-minio-change-this-password
MINIO_API_EXTERNAL_PORT=9000
MINIO_CONSOLE_EXTERNAL_PORT=9001
DR_AUTOMATIC_FAILOVER_ENABLED=false
GITOPS_REPOSITORY_URL=
GITOPS_TARGET_REVISION=main



# Sprint 16.6.1 — recuperação de senha e sessões persistentes
STANDARD_SESSION_HOURS=12
STANDARD_SESSION_IDLE_HOURS=8
PERSISTENT_SESSION_DAYS=30
PERSISTENT_SESSION_IDLE_DAYS=14
AUTH_REFRESH_COOKIE_NAME=educode_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# Em produção com HTTPS, altere para true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_MINUTES=60
RATE_LIMIT_PASSWORD_RESET_REQUESTS=5

# file: grava mensagens em ./storage/auth-mail-outbox
# smtp: entrega por SMTP
# disabled: não entrega mensagens
AUTH_MAIL_DELIVERY_MODE=file
AUTH_MAIL_OUTBOX_PATH=/app/storage/auth-mail-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15


# Sprint 16.7.1 — estabilização de intervenções
INTERVENTION_EVIDENCE_WINDOW_DAYS=90
INTERVENTION_MINIMUM_IMPROVEMENT=0.03


# Sprint 16.8 — avaliação longitudinal e eficácia
INTERVENTION_RETENTION_TOLERANCE=0.05
INTERVENTION_EFFECTIVENESS_MIN_GROUP_SIZE=5
INTERVENTION_EFFECTIVENESS_REFRESH_LIMIT=500


# Sprint 16.9 — governança institucional
GOVERNANCE_ENFORCEMENT_MODE=monitor
GOVERNANCE_MIN_APPROVALS=2
GOVERNANCE_MIN_GROUP_SIZE=5
GOVERNANCE_MONITORING_LOOKBACK_DAYS=90
GOVERNANCE_MIN_DOCUMENTATION_COMPLETENESS=0.85


# Sprint 16.10 — editor visual inteligente
COMIC_EDITOR_MAX_PAGES=100
COMIC_EDITOR_DEFAULT_ZOOM=110
COMIC_EDITOR_AI_STORY_REVIEW_REQUIRED=true


# Sprint 16.10.1 — capa, foco e estabilização
COMIC_EDITOR_AUTOSAVE_DELAY_MS=2200
COMIC_EDITOR_HISTORY_LIMIT=50
COMIC_EDITOR_COVER_VARIATIONS=4


# Sprint 16.10.2 — produtividade e assistente narrativo
COMIC_EDITOR_READABILITY_WORD_LIMIT=120
COMIC_EDITOR_WARNING_WORD_LIMIT=70
COMIC_EDITOR_CUSTOM_LAYOUT_LIMIT=100
